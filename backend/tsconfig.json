{
  "compilerOptions": {
    // Куда класть скомпилированный JS, откуда брать TS
    "rootDir": "./src",
    "outDir": "./dist",

    // Окружение: Node + CommonJS
    "target": "ES2020",
    "module": "CommonJS",
    "moduleResolution": "node",

    // Типы и модули
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "types": ["node"],

    // Строгий режим
    "strict": true,
    "skipLibCheck": true
  },
  "include": ["src"]
}
